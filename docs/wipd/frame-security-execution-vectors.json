  "security_vectors": [
    {
      "name": "local-peer-owner-match",
      "boundary": "local-before-http",
      "facts": ["socket-owner=uid:1000", "peer-effective=uid:1000"],
      "expected_code": "authenticated",
      "submitted": false,
      "effects": "negotiation-may-begin"
    },
    {
      "name": "local-peer-owner-mismatch",
      "boundary": "local-before-http",
      "facts": ["socket-owner=uid:1000", "peer-effective=uid:1001", "header-x-peer-uid=1000"],
      "expected_code": "auth.local-peer-mismatch",
      "submitted": false,
      "effects": "close-no-parse-no-state"
    },
    {
      "name": "remote-authority-pin-mismatch",
      "boundary": "remote-tls-server-auth",
      "facts": ["hostname-valid=true", "domain-binding-valid=true", "spki-pin-match=false"],
      "expected_code": "auth.authority-pin-mismatch",
      "submitted": false,
      "effects": "close-no-client-credential-no-state"
    },
    {
      "name": "remote-environment-domain-mismatch",
      "boundary": "remote-mtls-before-protocol",
      "facts": ["profile-domain=01K5V8K1Q5VX6Y0J8C9W3M4N5P", "certificate-domain=01K6B000000000000000000001", "certificate-owner-root-match=true"],
      "expected_code": "auth.environment-domain-mismatch",
      "submitted": false,
      "effects": "close-no-protocol-no-state"
    },
    {
      "name": "remote-environment-revoked-on-retained-connection",
      "boundary": "remote-before-new-exchange",
      "facts": ["tls-established=true", "certificate-revoked-since-last-exchange=true"],
      "expected_code": "auth.environment-revoked",
      "submitted": false,
      "effects": "refuse-new-exchange-no-rollback-of-prior-submission"
    },
    {
      "name": "enrollment-grant-reuse-with-different-key",
      "boundary": "remote-enrollment",
      "facts": ["grant-consumed=true", "csr-spki-digest-match-original=false"],
      "expected_code": "auth.grant-consumed",
      "submitted": false,
      "effects": "no-certificate-issued-no-state-change"
    },
    {
      "name": "application-signature-cannot-replace-mtls",
      "boundary": "remote-before-protocol",
      "facts": ["client-certificate-present=false", "application-signature-present=true"],
      "expected_code": "auth.environment-certificate-required",
      "submitted": false,
      "effects": "close-no-protocol-no-state"
    }
