# shellcheck shell=bash
# The directive above must stand alone: direnv sources this file, so it
# has no shebang for shellcheck to infer a shell from (SC2148), and a
# directive line that also carries prose is itself an error (SC1125).
if ! has nix; then
  echo "wip: nix not found — install determinate.systems/nix-installer to use this dev shell." >&2
  return 0
fi

use flake
