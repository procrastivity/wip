#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
compose_file="$root/contrib/orb-smoke/compose.yaml"
policy="$root/contrib/orb-smoke/policy.jq"
tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT INT TERM

export WIP_SMOKE_RUN_ID=policy-test
export WIP_ORB_SMOKE_IMAGE=wip-orb-smoke-policy-test:local

valid="$tmp_dir/valid.json"
docker compose -f "$compose_file" config --format json >"$valid"
jq -e -f "$policy" "$valid" >/dev/null

reject_mutation() {
  local name="$1"
  local expression="$2"
  local candidate="$tmp_dir/$name.json"
  jq "$expression" "$valid" >"$candidate"
  if jq -e -f "$policy" "$candidate" >/dev/null; then
    printf 'orb policy: accepted forbidden mutation: %s\n' "$name" >&2
    exit 1
  fi
}

reject_mutation privileged '.services["authority-env"].privileged = true'
reject_mutation missing-no-new-privileges '.services["authority-env"].security_opt = []'
reject_mutation host-network '.services["authority-env"].network_mode = "host"'
reject_mutation host-pid '.services["authority-env"].pid = "host"'
reject_mutation bind-mount '.services["authority-env"].volumes[0] = {"type":"bind","source":"/home/user/.wip","target":"/var/lib/wip-smoke"}'
reject_mutation docker-socket '.services["authority-env"].volumes[0] = {"type":"bind","source":"/var/run/docker.sock","target":"/var/run/docker.sock"}'
reject_mutation shared-state '.services["client-env"].volumes[0].source = "authority-state"'
reject_mutation published-port '.services["authority-env"].ports = [{"target":8080,"published":"8080"}]'
reject_mutation inherited-credential '.services["authority-env"].environment.GH_TOKEN = "forbidden"'
reject_mutation legacy-route '.services["client-env"].environment.WIP_AUTHORITY_URL = "https://legacy.example"'
reject_mutation extra-service '.services.extra = .services["client-env"]'
reject_mutation external-network '.networks.lab.internal = false'

printf 'orb policy: PASS\n'
