#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
compose_file="$root/contrib/online-authority-proof/compose.yaml"
policy="$root/contrib/online-authority-proof/policy.jq"
tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT INT TERM

valid="$tmp_dir/valid.json"
project=wip-authority-proof-policytest
docker compose -p "$project" -f "$compose_file" config --no-env-resolution --format json >"$valid"
jq -e --arg project "$project" -f "$policy" "$valid" >/dev/null

reject_mutation() {
  local name="$1"
  local expression="$2"
  local candidate="$tmp_dir/$name.json"
  jq "$expression" "$valid" >"$candidate"
  if jq -e --arg project "$project" -f "$policy" "$candidate" >/dev/null; then
    printf 'online authority lab policy: accepted forbidden mutation: %s\n' "$name" >&2
    exit 1
  fi
}

reject_mutation host-bind '.services["authority-env"].volumes[0] = {"type":"bind","source":"/home/user/.wip","target":"/var/lib/online-authority-proof"}'
reject_mutation shared-volume '.services["client-env"].volumes[0].source = "authority-state"'
reject_mutation external-network '.networks.lab.internal = false'
reject_mutation host-network '.services["authority-env"].network_mode = "host"'
reject_mutation published-port '.services["authority-env"].ports = [{"target":8080,"published":"8080"}]'
reject_mutation credential-env '.services["client-env"].environment.GH_TOKEN = "forbidden"'
reject_mutation extra-service '.services.harness = .services["client-env"]'
reject_mutation bind-backed-volume '.volumes["authority-state"].driver_opts = {"type":"none","o":"bind","device":"/home/user/.wip"}'
reject_mutation external-volume '.volumes["authority-state"].external = true'
reject_mutation shared-volume-name '.volumes["authority-state"].name = "shared-authority-data"'
reject_mutation top-level-secret '.secrets["host-key"] = {"file":"/home/user/.ssh/id_ed25519"}'
reject_mutation top-level-config '.configs["host-config"] = {"file":"/home/user/.ssh/id_ed25519"}'
reject_mutation service-secret '.services["authority-env"].secrets = [{"source":"host-key","target":"id_ed25519"}]'
reject_mutation service-config '.services["client-env"].configs = [{"source":"host-config","target":"host-config"}]'
reject_mutation service-env-file '.services["authority-env"].env_file = ["/home/user/.ssh/id_ed25519"]'

reject_compose_mutation() {
  local name="$1"
  local expression="$2"
  local candidate="$tmp_dir/$name.compose.json"
  local rendered="$tmp_dir/$name.rendered.json"
  jq "$expression" "$valid" >"$candidate"
  docker compose -p "$project" -f "$candidate" config --no-env-resolution --format json >"$rendered"
  if jq -e --arg project "$project" -f "$policy" "$rendered" >/dev/null; then
    printf 'online authority lab policy: accepted Compose-valid mutation: %s\n' "$name" >&2
    exit 1
  fi
}

reject_compose_mutation volumes-from '.services["client-env"].volumes_from = ["authority-env"]'
reject_compose_mutation shared-network-name '.networks.lab.name = "shared-lab-network"'
reject_compose_mutation external-network-definition '.networks.lab = {"name":"shared-lab-network","external":true}'
reject_compose_mutation shared-pid-namespace '.services["client-env"].pid = "service:authority-env"'
reject_compose_mutation shared-ipc-namespace '.services["client-env"].ipc = "service:authority-env"'
reject_compose_mutation host-build-context '.services["client-env"].image = "wip-authority-proof-local:latest" | .services["client-env"].build = {"context":"/home/user/.wip","dockerfile_inline":"FROM alpine:3.22.1\nCOPY . /state"} | .services["client-env"].pull_policy = "build"'
reject_compose_mutation scaled-client '.services["client-env"].scale = 2'
reject_compose_mutation replicated-client '.services["client-env"].deploy = {"replicas":2}'
reject_compose_mutation external-provider '.services["client-env"].provider = {"type":"awesomecloud"}'

printf 'LAB_ENVIRONMENT=client\n' >"$tmp_dir/client.env"
reject_compose_mutation harmless-env-file ".services[\"client-env\"].env_file = [\"$tmp_dir/client.env\"]"

mock_bin="$tmp_dir/mock-bin"
mkdir -p "$mock_bin"
mock_log="$tmp_dir/docker.log"
cat >"$mock_bin/docker" <<'MOCK'
#!/usr/bin/env bash
set -eu
printf '%s\n' "$*" >>"$MOCK_DOCKER_LOG"
case "$1" in
  compose)
    if [[ "$*" == *"config --no-env-resolution --format json"* ]]; then
      cat "$MOCK_CONFIG"
    fi
    ;;
  ps)
    if [[ "${MOCK_COLLISION:-}" == container ]]; then
      printf 'foreign-container\n'
    fi
    ;;
  inspect)
    printf 'foreign-project foreign-owner\n'
    ;;
  network|volume)
    if [[ "$2" == inspect ]]; then
      printf 'foreign-project foreign-owner\n'
    elif [[ "$1" == volume && "${MOCK_COLLISION:-}" == volume ]]; then
      printf '%s\n' "$MOCK_EXPECTED_RESOURCE"
    fi
    ;;
esac
MOCK
chmod +x "$mock_bin/docker"

if PATH="$mock_bin:$PATH" MOCK_DOCKER_LOG="$mock_log" MOCK_CONFIG="$valid" \
  WIP_AUTHORITY_LAB_PROJECT=unrelated-project "$root/contrib/online-authority-proof/run" down \
  >/dev/null 2>&1; then
  printf 'online authority lab policy: accepted invalid project override\n' >&2
  exit 1
fi
[ ! -s "$mock_log" ] || { printf 'invalid project reached Docker\n' >&2; exit 1; }

collision_project=wip-authority-proof-collision
docker compose -p "$collision_project" -f "$compose_file" config --format json \
  >"$tmp_dir/collision.json"
if PATH="$mock_bin:$PATH" MOCK_DOCKER_LOG="$mock_log" \
  MOCK_CONFIG="$tmp_dir/collision.json" MOCK_COLLISION=container \
  WIP_AUTHORITY_LAB_PROJECT="$collision_project" "$root/contrib/online-authority-proof/run" down \
  >/dev/null 2>&1; then
  printf 'online authority lab policy: did not reject a colliding project override\n' >&2
  exit 1
fi
if grep -q ' down' "$mock_log"; then
  printf 'colliding project reached destructive down\n' >&2
  exit 1
fi

volume_project=wip-authority-proof-volumeclash
docker compose -p "$volume_project" -f "$compose_file" config --format json \
  >"$tmp_dir/volume-collision.json"
: >"$mock_log"
if PATH="$mock_bin:$PATH" MOCK_DOCKER_LOG="$mock_log" \
  MOCK_CONFIG="$tmp_dir/volume-collision.json" MOCK_COLLISION=volume \
  MOCK_EXPECTED_RESOURCE="${volume_project}_authority-state" \
  WIP_AUTHORITY_LAB_PROJECT="$volume_project" "$root/contrib/online-authority-proof/run" down \
  >/dev/null 2>&1; then
  printf 'online authority lab policy: did not reject a colliding named volume\n' >&2
  exit 1
fi
if grep -q ' down' "$mock_log"; then
  printf 'colliding named volume reached destructive down\n' >&2
  exit 1
fi

docker compose -p "$collision_project" -f "$compose_file" config --format json \
  | jq '.networks.lab.internal = false' >"$tmp_dir/invalid-config.json"
: >"$mock_log"
if PATH="$mock_bin:$PATH" MOCK_DOCKER_LOG="$mock_log" \
  MOCK_CONFIG="$tmp_dir/invalid-config.json" \
  WIP_AUTHORITY_LAB_PROJECT="$collision_project" "$root/contrib/online-authority-proof/run" down \
  >/dev/null 2>&1; then
  printf 'online authority lab policy: teardown accepted invalid Compose config\n' >&2
  exit 1
fi
if grep -Eq ' down| ps | network | volume ' "$mock_log"; then
  printf 'invalid Compose config reached Docker resource inspection or teardown\n' >&2
  exit 1
fi

printf 'online authority lab policy: PASS\n'
