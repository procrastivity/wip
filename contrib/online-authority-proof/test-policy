#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
compose_file="$root/contrib/online-authority-proof/compose.yaml"
policy="$root/contrib/online-authority-proof/policy.jq"
tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT INT TERM

valid="$tmp_dir/valid.json"
docker compose -f "$compose_file" config --format json >"$valid"
jq -e -f "$policy" "$valid" >/dev/null

reject_mutation() {
  local name="$1"
  local expression="$2"
  local candidate="$tmp_dir/$name.json"
  jq "$expression" "$valid" >"$candidate"
  if jq -e -f "$policy" "$candidate" >/dev/null; then
    printf 'online authority lab policy: accepted forbidden mutation: %s\n' "$name" >&2
    exit 1
  fi
}

reject_mutation host-bind '.services["authority-env"].volumes[0] = {"type":"bind","source":"/home/user/.wip","target":"/var/lib/online-authority-proof"}'
reject_mutation shared-volume '.services["client-env"].volumes[0].source = "authority-state"'
reject_mutation external-network '.networks.lab.internal = false'
reject_mutation host-network '.services["authority-env"].network_mode = "host"'
reject_mutation published-port '.services["authority-env"].ports = [{"target":8080,"published":"8080"}]'
reject_mutation credential-env '.services["client-env"].environment.GH_TOKEN = "forbidden"'
reject_mutation extra-service '.services.harness = .services["client-env"]'

printf 'online authority lab policy: PASS\n'
