#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
run="$root/contrib/online-authority-proof/run"
compose_file="$root/contrib/online-authority-proof/compose.yaml"
image='alpine:3.22.1@sha256:4bcff63911fcb4448bd4fdacec207030997caf25e9bea4045fa6c8c44de311d1'
volume_root=/var/lib/online-authority-proof
state_root="$volume_root/.step20"
owner_label=com.procrastivity.wip.authority-proof
project="${WIP_AUTHORITY_LAB_PROJECT:-wip-authority-proof-step20-$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')}"
tmp_dir="$(mktemp -d)"
cleanup_needed=0

fail() {
  printf 'online authority lab runtime: %s\n' "$*" >&2
  exit 1
}

command -v docker >/dev/null || fail 'docker CLI is unavailable'
command -v jq >/dev/null || fail 'jq is unavailable'
command -v go >/dev/null || fail 'Go is unavailable; enter the repository dev shell first'
[[ "$project" =~ ^wip-authority-proof-[a-z0-9][a-z0-9_-]{0,31}$ ]] \
  || fail 'project must match wip-authority-proof-<lowercase-id> (1-32 characters)'

compose() {
  docker compose -p "$project" -f "$compose_file" "$@"
}

project_resources_absent() {
  local resource
  [[ -z "$(docker ps -aq --filter "label=com.docker.compose.project=$project")" ]] || return 1
  for resource in "${project}_authority-state" "${project}_client-state"; do
    docker volume inspect "$resource" >/dev/null 2>&1 && return 1
  done
  docker network inspect "${project}_lab" >/dev/null 2>&1 && return 1
  return 0
}

cleanup() {
  local status=$?
  trap - EXIT
  if [[ "$cleanup_needed" -eq 1 ]]; then
    if WIP_AUTHORITY_LAB_PROJECT="$project" "$run" down >"$tmp_dir/compose-down.log" 2>&1 \
      && project_resources_absent; then
      printf "PASS teardown removed this run's containers, network, and named volumes\n"
    else
      printf 'FAIL teardown did not remove all resources for project %s\n' "$project" >&2
      status=1
    fi
  fi
  rm -rf "$tmp_dir"
  exit "$status"
}
trap cleanup EXIT

docker info --format '{{.ServerVersion}}' >/dev/null \
  || fail 'Docker Engine is unavailable'
"$run" config >/dev/null
project_resources_absent || fail "project collision: $project already has containers, network, or volumes"

CGO_ENABLED=0 go build -trimpath -o "$tmp_dir/wipd" ./cmd/wipd
CGO_ENABLED=0 go test -c -trimpath -o "$tmp_dir/wipdauthority.test" ./internal/wipdauthority
test_filter='^(TestM5AuthorityBackedMatterAndStepBirthThroughWipdProcess|TestM5TwoEnvironmentClaimCloseAndFinalPullSpine|TestM5CrossContainerClientProjectionEvidence)$'
listed_tests="$("$tmp_dir/wipdauthority.test" -test.list "$test_filter")"
for test_name in \
  TestM5AuthorityBackedMatterAndStepBirthThroughWipdProcess \
  TestM5TwoEnvironmentClaimCloseAndFinalPullSpine \
  TestM5CrossContainerClientProjectionEvidence; do
  grep -Fqx "$test_name" <<<"$listed_tests" \
    || fail "compiled process acceptance binary is missing $test_name"
done
worker_test_list="$("$tmp_dir/wipdauthority.test" -test.list '^TestM5CrossContainerAuthorityFixtureWorker$')"
grep -Fqx TestM5CrossContainerAuthorityFixtureWorker <<<"$worker_test_list" \
  || fail 'compiled process acceptance binary is missing TestM5CrossContainerAuthorityFixtureWorker'

cleanup_needed=1
if ! WIP_AUTHORITY_LAB_PROJECT="$project" "$run" up >"$tmp_dir/compose-up.log" 2>&1; then
  printf 'FAIL Compose startup for project %s\n' "$project" >&2
  tail -n 20 "$tmp_dir/compose-up.log" >&2 || true
  exit 1
fi

mapfile -t authority_containers < <(compose ps --status running --quiet authority-env)
mapfile -t client_containers < <(compose ps --status running --quiet client-env)
[[ "${#authority_containers[@]}" -eq 1 && "${#client_containers[@]}" -eq 1 ]] \
  || fail 'runtime did not start exactly one authority-env and one client-env'
authority_id="${authority_containers[0]}"
client_id="${client_containers[0]}"
network_id="${project}_lab"

assert_container_isolation() {
  local container_id="$1" service="$2" environment="$3" volume="$4" inspection checks
  inspection="$(docker inspect "$container_id")"
  checks="$(jq \
    --arg project "$project" \
    --arg network "$network_id" \
    --arg image "$image" \
    --arg service "$service" \
    --arg environment "$environment" \
    --arg volume "${project}_${volume}" \
    --arg owner_label "$owner_label" \
    --arg state_root "$volume_root" \
    '
      .[0] as $container |
      {
        running: ($container.State.Running == true),
        pinned_image: ($container.Config.Image == $image),
        project_label: ($container.Config.Labels["com.docker.compose.project"] == $project),
        service_label: ($container.Config.Labels["com.docker.compose.service"] == $service),
        owner_label: ($container.Config.Labels[$owner_label] == "lab-v1"),
        read_only_root: ($container.HostConfig.ReadonlyRootfs == true),
        not_privileged: ($container.HostConfig.Privileged == false),
        all_capabilities_dropped: (($container.HostConfig.CapDrop | index("ALL")) != null),
        no_added_capabilities: ($container.HostConfig.CapAdd == null or ($container.HostConfig.CapAdd | length) == 0),
        no_new_privileges: (($container.HostConfig.SecurityOpt | index("no-new-privileges:true")) != null),
        no_host_bind_mounts: all($container.Mounts[]; .Type == "volume"),
        no_devices: ($container.HostConfig.Devices == null or ($container.HostConfig.Devices | length) == 0),
        no_volumes_from: ($container.HostConfig.VolumesFrom == null or ($container.HostConfig.VolumesFrom | length) == 0),
        no_published_ports: ($container.HostConfig.PortBindings == null or ($container.HostConfig.PortBindings | length) == 0),
        correct_network_mode: ($container.HostConfig.NetworkMode == $network),
        private_pid_namespace: ($container.HostConfig.PidMode != "host"),
        private_ipc_namespace: ($container.HostConfig.IpcMode != "host"),
        expected_environment: ($container.Config.Env | map(select(startswith("LAB_ENVIRONMENT="))) == ["LAB_ENVIRONMENT=" + $environment]),
        no_secret_environment_keys: all($container.Config.Env[]?;
          (split("=")[0] | test("(?i)(token|secret|password|credential|private[_-]?key)")) | not),
        only_lab_network: ($container.NetworkSettings.Networks | keys == [$network]),
        one_mount: (($container.Mounts | length) == 1),
        named_volume: ($container.Mounts[0].Type == "volume" and $container.Mounts[0].Name == $volume),
        volume_target: ($container.Mounts[0].Destination == $state_root),
        volume_writable: ($container.Mounts[0].RW == true)
      }
    ' <<<"$inspection")"
  if ! jq -e 'all(.[]; . == true)' <<<"$checks" >/dev/null; then
    printf 'FAIL runtime container isolation for %s (project=%s, container=%s): ' \
      "$service" "$project" "${container_id:0:12}" >&2
    jq -c '.' <<<"$checks" >&2
    fail "runtime container isolation check failed for $service"
  fi

  if docker exec "$container_id" sh -c 'touch /etc/.step20-readonly-probe' \
    >/dev/null 2>&1; then
    docker exec "$container_id" rm -f /etc/.step20-readonly-probe >/dev/null 2>&1 || true
    fail "$service root filesystem accepted a write despite read_only"
  fi
  docker exec "$container_id" sh -c '
    for path in /run/docker.sock /var/run/docker.sock /home/user/workspace/repo/.wip /home/user/.wip /root/.wip; do
      [ ! -e "$path" ] || exit 1
    done
  ' || fail "$service can see a host Docker socket or host WIP state path"
}

network_inspection="$(docker network inspect "$network_id")"
jq -e \
  --arg project "$project" \
  --arg owner_label "$owner_label" \
  --arg authority_id "$authority_id" \
  --arg client_id "$client_id" \
  '
    .[0] as $network |
    $network.Internal == true and
    $network.Driver == "bridge" and
    $network.Labels["com.docker.compose.project"] == $project and
    $network.Labels[$owner_label] == "lab-v1" and
    $network.Containers[$authority_id] != null and
    $network.Containers[$client_id] != null and
    ($network.Containers | length) == 2
  ' <<<"$network_inspection" >/dev/null \
  || fail 'runtime network is not the isolated two-container lab network'

assert_container_isolation "$authority_id" authority-env authority authority-state
assert_container_isolation "$client_id" client-env client client-state
printf 'PASS runtime isolation: project=%s authority=%s client=%s internal-network=%s\n' \
  "$project" "${authority_id:0:12}" "${client_id:0:12}" "$network_id"

docker exec "$authority_id" sh -c 'printf authority-only > "$1/.step20-authority-volume-probe"' sh "$volume_root"
docker exec "$authority_id" test -f "$volume_root/.step20-authority-volume-probe"
if docker exec "$client_id" test -e "$volume_root/.step20-authority-volume-probe"; then
  fail 'authority named volume is visible in client-env'
fi
docker exec "$client_id" sh -c 'printf client-only > "$1/.step20-client-volume-probe"' sh "$volume_root"
docker exec "$client_id" test -f "$volume_root/.step20-client-volume-probe"
if docker exec "$authority_id" test -e "$volume_root/.step20-client-volume-probe"; then
  fail 'client named volume is visible in authority-env'
fi
docker exec "$authority_id" rm -f "$volume_root/.step20-authority-volume-probe"
docker exec "$client_id" rm -f "$volume_root/.step20-client-volume-probe"
printf 'PASS named-volume isolation: each service sees only its own writable state volume\n'

run_process_acceptance() {
  local container_id="$1" service="$2" state_dir="$state_root/acceptance" log="$tmp_dir/$2-acceptance.log"
  docker exec "$container_id" mkdir -p "$state_dir"
  docker exec "$container_id" chmod 700 "$volume_root" "$state_root" "$state_dir"
  docker cp "$tmp_dir/wipd" "$container_id:$state_root/wipd" >/dev/null
  docker cp "$tmp_dir/wipdauthority.test" "$container_id:$state_root/wipdauthority.test" >/dev/null
  if ! docker exec \
    --env "TMPDIR=$state_dir" \
    --env "WIP_M5_WIPD_BINARY=$state_root/wipd" \
    "$container_id" "$state_root/wipdauthority.test" \
    -test.v -test.run "$test_filter" -test.count=1 >"$log" 2>&1; then
    printf 'FAIL M5 process acceptance in %s; failed tests: ' "$service" >&2
    awk '/^--- FAIL: / { printf "%s ", $3 } END { print "" }' "$log" >&2
    awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^[[:alnum:]_.\/-]+\.go:[0-9]+:$/) { sub(/:$/, "", $i); print $i } }' \
      "$log" | sort -u | tr '\n' ' ' >&2
    printf '\n' >&2
    return 1
  fi
  for test_name in \
    TestM5AuthorityBackedMatterAndStepBirthThroughWipdProcess \
    TestM5TwoEnvironmentClaimCloseAndFinalPullSpine; do
    awk -v name="$test_name" '$1 == "---" && $2 == "PASS:" && $3 == name { passed = 1 } END { exit !passed }' "$log" \
      || fail "$service did not report a pass for $test_name"
  done
  docker exec "$container_id" sh -c '
    [ -z "$(ls -1A "$1")" ]
  ' sh "$state_dir" \
    || fail "$service retained temporary M5 profile/journal state after acceptance"
  printf 'PASS M5 fault-injection and two-Environment acceptance: service=%s volume=%s\n' \
    "$service" "${project}_$( [[ "$service" == authority-env ]] && printf authority-state || printf client-state )"
}

run_cross_container_acceptance() {
  local authority_dir="$state_root/cross-container-authority"
  local client_dir="$state_root/cross-container-client"
  local client_tmp_dir="$volume_root/.m5-tmp"
  local bundle_path="$authority_dir/bundle.json"
  local stop_path="$authority_dir/stop"
  local authority_evidence_path="$authority_dir/evidence.json"
  local authority_log="$authority_dir/worker.log"
  local client_bundle_path="$client_dir/bundle.json"
  local client_evidence_path="$client_dir/evidence.json"
  local bundle_copy="$tmp_dir/cross-container-bundle.json"
  local authority_evidence_copy="$tmp_dir/cross-container-authority-evidence.json"
  local client_evidence_copy="$tmp_dir/cross-container-client-evidence.json"
  local attempts

  docker exec "$authority_id" mkdir -p "$authority_dir"
  docker exec "$client_id" mkdir -p "$client_dir"
  docker exec "$client_id" mkdir -p "$client_tmp_dir"
  docker exec "$authority_id" chmod 700 "$volume_root" "$state_root" "$authority_dir"
  docker exec "$client_id" chmod 700 "$volume_root" "$state_root" "$client_dir" "$client_tmp_dir"
  docker cp "$tmp_dir/wipd" "$authority_id:$state_root/wipd" >/dev/null
  docker cp "$tmp_dir/wipdauthority.test" "$authority_id:$state_root/wipdauthority.test" >/dev/null
  docker cp "$tmp_dir/wipd" "$client_id:$state_root/wipd" >/dev/null
  docker cp "$tmp_dir/wipdauthority.test" "$client_id:$state_root/wipdauthority.test" >/dev/null

  docker exec -d \
    --env "TMPDIR=$authority_dir" \
    --env "WIP_M5_CROSS_CONTAINER_BUNDLE_OUTPUT=$bundle_path" \
    --env "WIP_M5_CROSS_CONTAINER_STOP=$stop_path" \
    --env "WIP_M5_CROSS_CONTAINER_AUTHORITY_EVIDENCE=$authority_evidence_path" \
    "$authority_id" sh -c '
      "$1" -test.v -test.run "^TestM5CrossContainerAuthorityFixtureWorker$" -test.count=1 >"$2" 2>&1
    ' sh "$state_root/wipdauthority.test" "$authority_log"

  for ((attempts = 0; attempts < 120; attempts++)); do
    if docker exec "$authority_id" test -s "$bundle_path"; then
      break
    fi
    if docker exec "$authority_id" grep -Eq '^--- (FAIL|PASS): TestM5CrossContainerAuthorityFixtureWorker' "$authority_log"; then
      docker exec "$authority_id" cat "$authority_log" >&2
      fail 'authority-side cross-container fixture worker exited before publishing its client bundle'
    fi
    sleep 0.25
  done
  docker exec "$authority_id" test -s "$bundle_path" || {
    docker exec "$authority_id" cat "$authority_log" >&2 || true
    fail 'authority-side cross-container fixture worker did not become ready'
  }

  docker cp "$authority_id:$bundle_path" "$bundle_copy" >/dev/null
  chmod 644 "$bundle_copy"
  docker cp "$bundle_copy" "$client_id:$client_bundle_path" >/dev/null
  if ! docker exec \
    --env "TMPDIR=$client_tmp_dir" \
    --env "WIP_M5_WIPD_BINARY=$state_root/wipd" \
    --env "WIP_M5_CROSS_CONTAINER_BUNDLE=$client_bundle_path" \
    --env "WIP_M5_CROSS_CONTAINER_CLIENT_EVIDENCE=$client_evidence_path" \
    "$client_id" "$state_root/wipdauthority.test" \
    -test.v -test.run '^TestM5TwoEnvironmentClaimCloseAndFinalPullSpine$' -test.count=1 \
    >"$tmp_dir/client-cross-container-acceptance.log" 2>&1; then
    cat "$tmp_dir/client-cross-container-acceptance.log" >&2
    docker exec "$authority_id" touch "$stop_path" || true
    fail 'client-env cross-container two-Environment M5 acceptance failed'
  fi
  grep -F -- '--- PASS: TestM5TwoEnvironmentClaimCloseAndFinalPullSpine (' \
    "$tmp_dir/client-cross-container-acceptance.log" >/dev/null \
    || fail 'client-env did not execute the M5 two-Environment acceptance test'
  docker exec "$client_id" test -s "$client_evidence_path" \
    || fail 'client-env did not write final convergence evidence'

  docker exec "$authority_id" touch "$stop_path"
  for ((attempts = 0; attempts < 120; attempts++)); do
    if docker exec "$authority_id" test -s "$authority_evidence_path"; then
      break
    fi
    sleep 0.25
  done
  docker exec "$authority_id" test -s "$authority_evidence_path" || {
    docker exec "$authority_id" cat "$authority_log" >&2 || true
    fail 'authority-env did not write the final typed authority evidence'
  }
  for ((attempts = 0; attempts < 120; attempts++)); do
    if docker exec "$authority_id" grep -F -- '--- PASS: TestM5CrossContainerAuthorityFixtureWorker (' "$authority_log" >/dev/null; then
      break
    fi
    sleep 0.25
  done
  docker exec "$authority_id" grep -F -- '--- PASS: TestM5CrossContainerAuthorityFixtureWorker (' "$authority_log" >/dev/null \
    || {
      docker exec "$authority_id" cat "$authority_log" >&2 || true
      fail 'authority-env cross-container worker did not pass'
    }

  docker cp "$authority_id:$authority_evidence_path" "$authority_evidence_copy" >/dev/null
  docker cp "$client_id:$client_evidence_path" "$client_evidence_copy" >/dev/null
  jq -n \
    --slurpfile authority "$authority_evidence_copy" \
    --slurpfile client "$client_evidence_copy" \
    '
      $authority[0] as $a | $client[0] as $c |
      {
        authority_as_of: $a.as_of, client_as_of: $c.as_of,
        authority_manifest: $a.manifest_digest, client_manifest: $c.manifest_digest,
        authority_event_count: ($a.events | length), client_event_count: ($c.event_records | length),
        contention: $a.contention_refusal,
        traffic_kinds: ([$a.traffic[].frame_kind] | unique),
        traffic_environments: ([$a.traffic[].environment_id] | unique),
        traffic_endpoints: ([$a.traffic[] | {host, remote_addr}] | unique),
        overlay_count: $c.overlay_count,
        authority_matter_projections: $a.matter_projections,
        environment_a_matter_projections: $c.environment_a_matter_projections,
        environment_b_matter_projections: $c.environment_b_matter_projections,
        environment_a_step_projection_count: ($c.environment_a_step_projections | length),
        environment_a_content_projection_count: ($c.environment_a_content_projections | length),
        checks: {
          schemas: ($a.schema == "wipd.m5-cross-container-authority-evidence/2" and
            $c.schema == "wipd.m5-cross-container-client-evidence/2"),
          identity: ($a.domain_id == $c.domain_id and $a.authority_epoch == $c.authority_epoch and
            $a.environment_a == $c.environment_a and $a.environment_b == $c.environment_b),
          provenance: ($a.source == "authority" and $a.reachability == "reachable" and
            $a.history_state == "current" and $a.matter_count == 2),
          as_of: ($a.as_of == $c.as_of),
          manifest: ($a.manifest_digest == $c.manifest_digest),
          events: ($a.events == $c.event_records),
          authority_projection_count: (($a.matter_projections | length) == $a.matter_count and $a.matter_count == 2),
          both_matter_projections_match_authority: ($a.matter_projections == $c.environment_a_matter_projections and
            $a.matter_projections == $c.environment_b_matter_projections),
          client_projection_values_match: ($c.environment_a_matter_projections == $c.environment_b_matter_projections and
            $c.environment_a_step_projections == $c.environment_b_step_projections and
            $c.environment_a_content_projections == $c.environment_b_content_projections and
            ($c.environment_a_step_projections | length) == 2 and
            ($c.environment_a_content_projections | length) == 4),
          contention: ($a.contention_refusal.environment_id == $a.environment_b and
            $a.contention_refusal.matter_id != "" and $a.contention_refusal.prefix_unchanged == true and
            $a.contention_refusal.before == $a.contention_refusal.after),
          event_count: ($c.as_of.EventCount == ($c.event_records | length)),
          overlay_minimum: ($c.overlay_count >= 8),
          endpoints: all($a.traffic[]; .host == "authority-env:8443" and .remote_addr != "" and
            (.remote_addr | startswith("127.") | not) and (.remote_addr | startswith("[::1]:") | not)),
          required_kinds: (all(["claim.acquire", "command.submit", "claim-journal.ack", "claim-journal.seal", "claim.release", "pull.request"][];
            . as $kind | ([$a.traffic[].frame_kind] | index($kind)) != null)),
          both_environments: (all([$a.environment_a, $a.environment_b][];
            . as $environment | ([$a.traffic[].environment_id] | index($environment)) != null))
        }
      }
    ' >"$tmp_dir/convergence.json" \
    || fail 'could not compare authority and client M5 evidence'
  jq -e 'all(.checks[]; .)' "$tmp_dir/convergence.json" >/dev/null \
    || {
      cat "$tmp_dir/convergence.json" >&2
      fail 'authority and both Environment pulls do not converge at the exact authority prefix/manifest/projection values'
    }

  docker exec "$authority_id" rm -f "$bundle_path" "$stop_path" "$authority_evidence_path" "$authority_log" \
    "$state_root/wipd" "$state_root/wipdauthority.test"
  docker exec "$client_id" rm -f "$client_bundle_path" "$client_evidence_path" \
    "$state_root/wipd" "$state_root/wipdauthority.test"
  docker exec "$client_id" sh -c '[ -z "$(ls -1A "$1")" ]' sh "$client_tmp_dir" \
    || fail 'client-env retained temporary process acceptance state'
  docker exec "$client_id" rmdir "$client_tmp_dir"
  docker exec "$authority_id" sh -c '[ -z "$(ls -1A "$1")" ]' sh "$authority_dir" \
    || fail 'authority-env retained disposable cross-container fixture state'
  docker exec "$client_id" sh -c '[ -z "$(ls -1A "$1")" ]' sh "$client_dir" \
    || fail 'client-env retained disposable cross-container profile or journal state'
  docker exec "$authority_id" rmdir "$authority_dir"
  docker exec "$client_id" rmdir "$client_dir"
  printf 'PASS cross-container M5 claim lifecycle: authority-env=%s client-env=%s endpoint=https://authority-env:8443 internal-network=%s\n' \
    "${authority_id:0:12}" "${client_id:0:12}" "$network_id"
  printf 'PASS cross-container M5 traffic and convergence: authenticated claim.acquire/command.submit/journal return/release/final pull; exact event prefix and manifest match\n'
}

run_process_acceptance "$authority_id" authority-env
run_cross_container_acceptance

ordering_filter='^(TestConnectedCommandStartReturnsPendingPrefixBeforeTailAndWrite|TestConnectedCommandStartWithoutPendingPullsBeforeGuard|TestCommandStartPullFailureAndRestartDoNotReturnUnadmittedHead|TestConnectedCommandStartSerializesAdmissionAndPullThroughSharedDomainLane)$'
ordering_tests="$(go test ./internal/wipd -list "$ordering_filter")" \
  || fail 'could not list command-start pull-ordering regressions'
for test_name in \
  TestConnectedCommandStartReturnsPendingPrefixBeforeTailAndWrite \
  TestConnectedCommandStartWithoutPendingPullsBeforeGuard \
  TestCommandStartPullFailureAndRestartDoNotReturnUnadmittedHead \
  TestConnectedCommandStartSerializesAdmissionAndPullThroughSharedDomainLane; do
  grep -Fqx "$test_name" <<<"$ordering_tests" \
    || fail "command-start pull-ordering suite does not select $test_name"
done
if go test -v ./internal/wipd -run "$ordering_filter" -count=1 >"$tmp_dir/command-start.log" 2>&1; then
  for test_name in \
    TestConnectedCommandStartReturnsPendingPrefixBeforeTailAndWrite \
    TestConnectedCommandStartWithoutPendingPullsBeforeGuard \
    TestCommandStartPullFailureAndRestartDoNotReturnUnadmittedHead \
    TestConnectedCommandStartSerializesAdmissionAndPullThroughSharedDomainLane; do
    grep -F -- "--- PASS: $test_name (" "$tmp_dir/command-start.log" >/dev/null \
      || fail "command-start pull-ordering test did not execute: $test_name"
  done
  printf 'PASS command-start pull ordering: pending and no-pending concurrent-advance cases\n'
else
  printf 'FAIL command-start pull-ordering regressions\n' >&2
  awk '/^--- FAIL: / { print; next } /^FAIL([[:space:]]|$)/ { print "wipd test package failed" }' "$tmp_dir/command-start.log" >&2
  exit 1
fi

printf 'PASS runtime acceptance suites completed with fresh per-run volumes; teardown follows\n'
