{
  # Generated by contrib/promote-stable from contrib/stable-flake.nix.in on
  # main. Do not edit: the next release replaces this file.
  description = "wip @TAG@, prebuilt release binaries";

  inputs.nixpkgs.url = "github:NixOS/nixpkgs/@NIXPKGS_REV@";

  outputs = { self, nixpkgs }:
    let
      version = "@VERSION@";

      # The release publishes these binaries and no others, so other
      # systems get no package here. To build from source, use the flake
      # on main or at a release tag instead of this branch.
      assets = {
        x86_64-linux = { name = "wip-linux-amd64"; hash = "@HASH_LINUX_AMD64@"; };
        aarch64-darwin = { name = "wip-darwin-arm64"; hash = "@HASH_DARWIN_ARM64@"; };
      };

      forEachSystem = nixpkgs.lib.genAttrs (builtins.attrNames assets);
    in
    {
      packages = forEachSystem (system:
        let
          pkgs = nixpkgs.legacyPackages.${system};
          asset = assets.${system};
        in
        {
          default = pkgs.stdenvNoCC.mkDerivation {
            pname = "wip";
            inherit version;
            src = pkgs.fetchurl {
              url = "@URL_BASE@/${asset.name}";
              inherit (asset) hash;
            };
            dontUnpack = true;
            # The binary embeds its assets, so the share/ tree that the
            # source flake installs is not needed here.
            installPhase = ''
              runHook preInstall
              install -Dm755 "$src" "$out/bin/wip"
              runHook postInstall
            '';
            meta = {
              mainProgram = "wip";
              platforms = [ system ];
              sourceProvenance = [ nixpkgs.lib.sourceTypes.binaryNativeCode ];
            };
          };
        });

      overlays.default = final: prev: {
        "wip" = self.packages.${prev.system}.default;
      };
    };
}
