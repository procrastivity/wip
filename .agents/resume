#!/usr/bin/env bash
set -euo pipefail

# Setup persists the complete flake environment in ~/.bash_profile. Resume is
# intentionally a fast, non-installing repair and health check. Amp writes the
# current thread environment after setup; keep the Nix hook after that block so
# its PATH value cannot replace the dev shell's PATH.
profile="$HOME/.bash_profile"
activation="$HOME/.config/wip/orb-dev-shell.sh"
marker='# wip Nix development shell'
temporary="$(mktemp)"
touch "$profile"
awk -v marker="$marker" '
  $0 == marker { skipping = 1; next }
  skipping && $0 == "" { skipping = 0; next }
  !skipping { print }
' "$profile" >"$temporary"
cat "$temporary" >"$profile"
rm -f "$temporary"
printf '\n%s\nsource %q\n' "$marker" "$activation" >>"$profile"

nix_bin="$(command -v nix || true)"
if [ -z "$nix_bin" ] && [ -x /nix/var/nix/profiles/default/bin/nix ]; then
  nix_bin=/nix/var/nix/profiles/default/bin/nix
fi
if [ -n "$nix_bin" ]; then
  "$nix_bin" --version >/dev/null
fi

docker --version >/dev/null
docker compose version >/dev/null
